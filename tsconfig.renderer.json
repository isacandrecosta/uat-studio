{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist/web",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/renderer/**/*.ts", "src/diagnostico/ui/**/*.ts", "src/shared/**/*.ts"]
}
