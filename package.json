{
  "name": "uat-studio",
  "version": "0.1.0",
  "description": "Aplicação desktop portátil, offline e sem IA, para criar e correr testes UAT de apps OutSystems.",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/limpar.mjs && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "test": "npm run build && node --test dist/tests",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "diagnostico": "npm run build && electron dist/diagnostico/main.js",
    "diagnostico:smoke": "npm run build && electron dist/diagnostico/main.js --smoke",
    "diagnostico:exe": "npm run build && electron-builder --config electron-builder.diagnostico.json"
  },
  "author": "isacandrecosta",
  "license": "UNLICENSED",
  "dependencies": {
    "playwright-core": "^1.65.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron@45.2.3": true
  }
}
